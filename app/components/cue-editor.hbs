<div class="stage-shell">
  <header class="stage-header">
    <div class="brand">
      <span class="brand-mark">CUE</span>
      <div>
        <small>STAGE CALL &amp; PROMPT BOOK</small>
        <h1>{{this.show.title}}</h1>
      </div>
    </div>
    <div class="header-meta">
      <div class="mode-switch" role="tablist">
        <button type="button" class={{if (eq this.mode "scenes") "is-active"}} {{on "click" (fn this.switchMode "scenes")}}>场次调整</button>
        <button type="button" class={{if (eq this.mode "templates") "is-active"}} {{on "click" (fn this.switchMode "templates")}}>演出模板</button>
      </div>
      <span>{{this.show.venue}}</span>
      <span>{{this.show.date}}</span>
      <span class={{if this.errors "status-error" "status-ok"}}>{{if this.errors (concat this.errors " 项需处理") "当前无硬性冲突"}}</span>
    </div>
    <div class="header-actions">
      <PaperButton @onClick={{this.undo}} @title="撤销 Ctrl/Cmd+Z">撤销</PaperButton>
      <PaperButton @onClick={{this.redo}} @title="重做 Ctrl/Cmd+Y">重做</PaperButton>
      {{#if (eq this.mode "templates")}}
        <PaperButton @raised={{true}} @primary={{true}} @onClick={{this.createTemplateCueDraft}}>新增模板提示</PaperButton>
      {{else}}
        <PaperButton @raised={{true}} @primary={{true}} @onClick={{this.createLocalCueDraft}}>新增本场提示</PaperButton>
      {{/if}}
    </div>
  </header>

  {{#if this.pendingApply}}
    <section class="pending-banner" data-test-pending-banner>
      <div class="pending-text">
        <strong>套用模板未完成</strong>
        <small>
          原因：{{this.pendingApply.reason}}。已回滚到操作前状态
          （{{this.pendingSummary.scenes}} 场次 / {{this.pendingSummary.templates}} 模板 / {{this.pendingSummary.cues}} 提示，
          检查点{{if this.pendingSummary.intact "校验通过" "校验失败"}}）。
        </small>
      </div>
      <div class="pending-actions">
        <PaperButton @raised={{true}} @primary={{true}} @onClick={{this.retryPendingApply}}>重试套用</PaperButton>
        <PaperButton @warn={{true}} @onClick={{this.discardPendingApply}}>放弃并保持回滚状态</PaperButton>
      </div>
    </section>
  {{/if}}

  <section class="show-strip">
    <PaperInput @label="演出名称" @value={{this.show.title}} @onChange={{this.updateShowTitle}} class="show-title-input" />
    <div class="show-stats">
      <span><strong>{{this.show.scenes.length}}</strong> 场次</span>
      <span><strong>{{this.templates.length}}</strong> 模板</span>
      <span><strong>{{this.totalCueCount}}</strong> 条有效提示</span>
      <span><strong>{{this.errors}}</strong> 项阻塞</span>
    </div>
    <div class="search-box">
      <PaperInput @label="查找场次/模板" @value={{this.search}} @onChange={{this.setSearch}} />
    </div>
  </section>

  {{#if (eq this.mode "templates")}}
    {{! ==================== 模板模式：模板拥有固定流程 ==================== }}
    <main class="stage-workspace template-workspace" aria-label="演出模板编辑区">
      <aside class="scene-rail paper-surface" aria-label="模板列表">
        <div class="rail-heading">
          <div><small>TEMPLATES</small><h2>演出模板</h2></div>
          <PaperButton @iconButton={{true}} @primary={{true}} @onClick={{this.createTemplate}} @title="新建模板">＋</PaperButton>
        </div>
        <div class="scene-list">
          {{#each this.templateRows as |template|}}
            <button type="button" class="scene-item {{if template.active "is-active"}}" {{on "click" (fn this.selectTemplate template.id)}}>
              <span class="act-name">TEMPLATE · {{template.publishedLabel}}</span>
              <strong>{{template.name}}</strong>
              <small>{{template.cueCount}} 条提示 · 草稿 v{{template.version}} · {{template.pinnedScenes}} 场钉住</small>
            </button>
          {{else}}
            <p class="empty-copy">还没有模板，点击右上角新建。</p>
          {{/each}}
        </div>
        <div class="rail-footer">
          <p class="ownership-note">模板只维护固定流程：提示顺序、时长、负责人等基础值；各剧场场次只保存本场覆盖。</p>
        </div>
      </aside>

      <section class="cue-board" aria-label="模板提示编辑区">
        {{#if this.activeTemplate}}
          <div class="board-heading paper-surface template-heading">
            <div>
              <small>EDITING TEMPLATE · 工作草稿 v{{this.activeTemplate.current.version}}</small>
              <PaperInput @value={{this.activeTemplate.name}} @onChange={{this.updateTemplateName}} />
            </div>
            <div class="release-box">
              <PaperInput @label="发布说明" @value={{this.releaseNote}} @onChange={{this.updateReleaseNote}} />
              <PaperButton @raised={{true}} @primary={{true}} @onClick={{this.publishTemplate}}>发布新版本</PaperButton>
            </div>
          </div>

          <div class="timeline paper-surface">
            <div class="timeline-head">
              <div><small>TEMPLATE SEQUENCE</small><h2>固定流程（顺序 / 时长 / 负责人）</h2></div>
              <div class="keyboard-note">拖动调整模板顺序 · 改动对跟随场次立即生效 · <kbd>N</kbd> 新建</div>
            </div>
            <div class="timeline-labels">
              <span>序号</span><span>类型 / 提示内容</span><span>时长</span><span>负责人</span>
            </div>
            <div class="cue-list">
              {{#each this.templateCueRows as |cue|}}
                {{!-- template-lint-disable no-invalid-interactive no-heading-inside-button --}}
                <article
                  class="cue-row kind-template {{if cue.selected "is-selected"}}"
                  draggable="true"
                  {{on "dragstart" (fn this.startTemplateDrag cue.cueId)}}
                  {{on "dragover" this.allowDrop}}
                  {{on "drop" (fn this.dropTemplateOn cue.cueId)}}
                  {{on "click" (fn this.editTemplateCue cue.cueId)}}
                >
                  <div class="cue-time">
                    <span class="drag-dot">⠿</span>
                    <strong>{{cue.index}}</strong>
                    <small>{{cue.cueId}}</small>
                  </div>
                  <div class="cue-main">
                    <div class="cue-title-line">
                      <span class="cue-kind">{{cue.kind}}</span>
                      <h3>{{cue.title}}</h3>
                    </div>
                    <p>
                      {{#if cue.lighting}}灯光：{{cue.lighting}}{{/if}}
                      {{#if cue.sound}}音响：{{cue.sound}}{{/if}}
                      {{#if cue.props.length}}道具：{{join ", " cue.props}}{{/if}}
                      {{#if cue.cast.length}}演员：{{join ", " cue.cast}}{{/if}}
                    </p>
                  </div>
                  <div class="cue-duration">{{cue.duration}}<small>秒</small></div>
                  <div class="cue-owner">
                    <strong>{{if cue.owner cue.owner "待指定"}}</strong>
                  </div>
                </article>
                {{else}}
                  <div class="empty-board">
                    <h3>模板还没有提示点</h3>
                    <p>在这里定义固定流程；场次复制模板后，只能做本场覆盖，不能改模板。</p>
                  </div>
              {{/each}}
            </div>
          </div>

          <div class="release-panel paper-surface">
            <div class="panel-heading"><div><small>RELEASES</small><h2>已发布版本</h2></div></div>
            <div class="release-list">
              {{#each this.templateReleaseRows as |release|}}
                <div class="release-row">
                  <strong>v{{release.version}}</strong>
                  <span>{{release.note}}</span>
                  <small>{{release.updatedAt}} · {{release.cueCount}} 条 · {{release.pinnedLabel}}</small>
                </div>
              {{else}}
                <p class="empty-copy">尚未发布。工作草稿的即时改动只影响「跟随最新」的场次；发布后场次可钉版或迁移。</p>
              {{/each}}
            </div>
          </div>
        {{/if}}
      </section>

      <aside class="inspector-rail" aria-label="模板提示编辑面板">
        <section class="inspector paper-surface">
          <div class="inspector-heading">
            <div><small>{{if this.templateDraft "TEMPLATE CUE EDITOR" "TEMPLATE INSPECTOR"}}</small><h2>{{if this.templateDraft "编辑模板提示" "模板提示详情"}}</h2></div>
            {{#if this.templateDraft}}<button type="button" class="close-button" {{on "click" this.cancelTemplateDraft}}>×</button>{{/if}}
          </div>
          {{#if this.templateDraft}}
            <div class="draft-form">
              <PaperSelect @label="提示类型" @options={{this.cueKindOptions}} @selected={{this.templateDraft.kind}} @onChange={{fn this.updateTemplateDraft "kind"}} />
              <PaperInput @label="提示标题" @value={{this.templateDraft.title}} @onChange={{fn this.updateTemplateDraft "title"}} />
              <PaperInput @label="时长（秒）" @type="number" @value={{this.templateDraft.duration}} @onChange={{fn this.updateTemplateDraft "duration"}} />
              <PaperSelect @label="负责人" @options={{this.ownerOptions}} @selected={{this.templateDraft.owner}} @onChange={{fn this.updateTemplateDraft "owner"}} />
              <PaperInput @label="灯光提示" @textarea={{true}} @passThru={{hash rows=2}} @value={{this.templateDraft.lighting}} @onChange={{fn this.updateTemplateDraft "lighting"}} />
              <PaperInput @label="音响提示" @textarea={{true}} @passThru={{hash rows=2}} @value={{this.templateDraft.sound}} @onChange={{fn this.updateTemplateDraft "sound"}} />
              <PaperInput @label="道具（顿号分隔）" @value={{this.templateDraft.props}} @onChange={{fn this.updateTemplateDraft "props"}} />
              <PaperInput @label="演员（顿号分隔）" @value={{this.templateDraft.cast}} @onChange={{fn this.updateTemplateDraft "cast"}} />
              <PaperInput @label="前置提示 cueId" @value={{this.templateDraft.dependsOn}} @onChange={{fn this.updateTemplateDraft "dependsOn"}} />
              <PaperInput @label="备注" @textarea={{true}} @passThru={{hash rows=3}} @value={{this.templateDraft.notes}} @onChange={{fn this.updateTemplateDraft "notes"}} />
              <div class="form-actions">
                {{#if this.templateDraftCueId}}<PaperButton @warn={{true}} @onClick={{fn this.removeTemplateCue this.templateDraftCueId}}>从模板删除</PaperButton>{{/if}}
                <span></span>
                <PaperButton @onClick={{this.cancelTemplateDraft}}>取消</PaperButton>
                <PaperButton @raised={{true}} @primary={{true}} @onClick={{this.saveTemplateDraft}}>保存到模板</PaperButton>
              </div>
            </div>
          {{else}}
            <p class="empty-copy">选择一条模板提示查看并编辑基础值。模板改动不会写入任何场次。</p>
          {{/if}}
        </section>
      </aside>
    </main>
  {{else}}
    {{! ==================== 场次模式：场次只保存本场覆盖 ==================== }}
    <main class="stage-workspace" aria-label="场次调整编辑区">
      <aside class="scene-rail paper-surface" aria-label="导航列表">
        <div class="rail-heading">
          <div><small>SCENES</small><h2>幕次与场次</h2></div>
          <PaperButton @iconButton={{true}} @primary={{true}} @onClick={{this.addScene}} @title="新增空白手工场次">＋</PaperButton>
        </div>
        <div class="scene-list">
          {{#each this.filteredScenes as |scene|}}
            <button type="button" class="scene-item {{if scene.active "is-active"}}" {{on "click" (fn this.selectScene scene.id)}}>
              <span class="act-name">{{scene.templateName}} · {{scene.versionLabel}}{{if scene.locked " · 已锁定"}}</span>
              <strong>{{scene.act}} {{scene.name}} · {{scene.title}}</strong>
              <small>{{scene.startTime}} · {{scene.cueCount}} 条 · {{scene.issueCount}} 项检查{{if scene.stale " · 可迁移"}}{{if scene.detachedCount (concat " · " scene.detachedCount " 条待恢复")}}</small>
            </button>
          {{else}}
            <p class="empty-copy">未找到场次</p>
          {{/each}}
        </div>
        <div class="rail-footer">
          <PaperButton @raised={{true}} @primary={{true}} @onClick={{this.openApplyPicker}} class="wide-button" data-test-open-apply>复制新场次（选择模板）</PaperButton>
          <PaperButton @onClick={{this.copyPreviousScene}} class="wide-button">复制上一场（含本场覆盖）</PaperButton>
          <PaperButton @onClick={{this.lockVersion}} class="wide-button" @warn={{true}}>锁定当前版本</PaperButton>
        </div>
      </aside>

      <section class="cue-board" aria-label="场次提示合并视图">
        {{#if this.activeScene}}
          <div class="board-heading paper-surface">
            <div>
              <small>ACTIVE SCENE · 本场调整</small>
              <div class="scene-title-edit">
                <PaperInput @value={{this.activeScene.act}} @onChange={{fn this.updateSceneField "act"}} />
                <PaperInput @value={{this.activeScene.name}} @onChange={{fn this.updateSceneField "name"}} />
                <PaperInput @value={{this.activeScene.title}} @onChange={{fn this.updateSceneField "title"}} />
              </div>
            </div>
            <PaperInput @label="开场时间" @value={{this.activeScene.startTime}} @onChange={{fn this.updateSceneField "startTime"}} />
            <div class="lock-state">
              {{#if this.activeScene.locked}}
                <span class="locked-label">本场已锁定</span>
                <PaperButton @onClick={{this.createRevision}}>建立修订</PaperButton>
              {{else}}
                <PaperButton @onClick={{this.toggleSceneLock}}>锁定本场（钉版）</PaperButton>
              {{/if}}
            </div>
          </div>

          <div class="binding-strip paper-surface">
            {{#if this.activeBinding}}
              <div class="binding-info">
                <small>TEMPLATE BINDING · 模板归属</small>
                <strong>{{this.activeBinding.templateName}}</strong>
                <span class={{if this.activeBinding.stale "binding-stale" "binding-ok"}}>
                  {{this.activeBinding.versionLabel}}
                  {{#if this.activeBinding.stale}}
                    · 模板已升级，未覆盖项在迁移后取新版
                  {{else if this.activeBinding.pinned}}
                    · 已钉版，模板升级不影响本场
                  {{else}}
                    · 跟随最新版，模板一改立即重算
                  {{/if}}
                </span>
              </div>
              <div class="binding-actions">
                {{#if this.activeBinding.pinned}}
                  <PaperButton @onClick={{this.followLatestTemplate}}>改为跟随最新</PaperButton>
                {{/if}}
                {{#if this.activeBinding.stale}}
                  <PaperButton @raised={{true}} @primary={{true}} @onClick={{this.migrateSceneToLatest}}>迁移到 v{{this.activeBinding.latestVersion}}</PaperButton>
                {{/if}}
              </div>
            {{else}}
              <div class="binding-info">
                <small>TEMPLATE BINDING · 模板归属</small>
                <strong>无模板（手工场次）</strong>
                <span class="binding-ok">提示全部归本场所有；如需复用，可在「演出模板」中建立模板。</span>
              </div>
            {{/if}}
          </div>

            <div class="timeline paper-surface">
              <div class="timeline-head">
                <div><small>PROMPT SEQUENCE · 合并视图</small><h2>提示顺序与时间</h2></div>
                <div class="keyboard-note">模板值 + 本场覆盖 · 拖动仅记本场顺序 · <kbd>Alt</kbd> + <kbd>↑↓</kbd> 调整 · <kbd>N</kbd> 新建本场提示</div>
              </div>
              <div class="timeline-labels">
                <span>时间</span><span>类型 / 提示内容</span><span>时长</span><span>负责人</span>
              </div>
              <div class="cue-list">
                {{#each this.cueRows as |cue|}}
                  {{!-- template-lint-disable no-invalid-interactive no-heading-inside-button --}}
                  <article
                    class="cue-row kind-{{cue.kindClass}} {{if cue.selected "is-selected"}}"
                    draggable="true"
                    {{on "dragstart" (fn this.startDrag cue.id)}}
                    {{on "dragover" this.allowDrop}}
                    {{on "drop" (fn this.dropOn cue.id)}}
                    {{on "click" (fn this.selectCue cue.id)}}
                  >
                    <div class="cue-time">
                      <span class="drag-dot">⠿</span>
                      <strong>{{cue.start}}</strong>
                      <small>至 {{cue.end}}</small>
                    </div>
                    <div class="cue-main">
                      <div class="cue-title-line">
                        <span class="cue-index">{{cue.index}}</span>
                        <span class="cue-kind">{{cue.kind}}</span>
                        <h3>{{cue.title}}</h3>
                        <span class="source-badge source-{{cue.source}}">{{if (eq cue.source "template") "模板" "本场"}}</span>
                        {{#if cue.pinned}}<span class="source-badge source-pinned">钉版</span>{{/if}}
                        {{#if cue.overrideLabel}}<span class="override-badge">{{cue.overrideLabel}}</span>{{/if}}
                        {{#if cue.hasIssue}}<span class="issue-flag">检查</span>{{/if}}
                      </div>
                      <p>
                        {{#if cue.lighting}}灯光：{{cue.lighting}}{{/if}}
                        {{#if cue.sound}}音响：{{cue.sound}}{{/if}}
                        {{#if cue.props.length}}道具：{{join ", " cue.props}}{{/if}}
                        {{#if cue.cast.length}}演员：{{join ", " cue.cast}}{{/if}}
                      </p>
                    </div>
                    <div class="cue-duration {{if (cue.overridden.length) "is-overridden"}}">{{cue.duration}}<small>秒</small></div>
                    <div class="cue-owner {{if (cue.overridden.length) "is-overridden"}}">
                      <strong>{{if cue.owner cue.owner "待指定"}}</strong>
                      <small>{{if cue.dependsOn.length (concat cue.dependsOn.length " 个前置") "无前置依赖"}}</small>
                    </div>
                  </article>
                  {{else}}
                    <div class="empty-board">
                      <h3>本场还没有有效提示</h3>
                      <p>模板提示被全部停用时可新增本场提示；有绑定时也可直接在模板中维护固定流程。</p>
                    </div>
                {{/each}}
              </div>
              <button type="button" class="add-row" {{on "click" this.createLocalCueDraft}}>＋ 添加本场提示点</button>
            </div>
        {{/if}}
      </section>

      <aside class="inspector-rail" aria-label="详情与检查面板">
        <section class="inspector paper-surface">
          <div class="inspector-heading">
            <div><small>{{if this.draft "CUE OVERRIDE EDITOR" "CUE INSPECTOR"}}</small><h2>{{this.draftHeading}}</h2></div>
            {{#if this.draft}}<button type="button" class="close-button" {{on "click" this.cancelDraft}}>×</button>{{/if}}
          </div>
          {{#if this.draft}}
            <div class="draft-form">
              {{#if (eq this.editTarget.source "template")}}
                <p class="ownership-note">保存的是<strong>本场覆盖</strong>：留回模板值的字段会自动清除覆盖；模板本身不变。</p>
              {{/if}}
              <PaperSelect @label="提示类型" @options={{this.cueKindOptions}} @selected={{this.draft.kind}} @onChange={{fn this.updateDraft "kind"}} />
              <PaperInput @label="提示标题" @value={{this.draft.title}} @onChange={{fn this.updateDraft "title"}} />
              <PaperInput @label="时长（秒）" @type="number" @value={{this.draft.duration}} @onChange={{fn this.updateDraft "duration"}} />
              <PaperSelect @label="负责人" @options={{this.ownerOptions}} @selected={{this.draft.owner}} @onChange={{fn this.updateDraft "owner"}} />
              <PaperInput @label="灯光提示" @textarea={{true}} @passThru={{hash rows=2}} @value={{this.draft.lighting}} @onChange={{fn this.updateDraft "lighting"}} />
              <PaperInput @label="音响提示" @textarea={{true}} @passThru={{hash rows=2}} @value={{this.draft.sound}} @onChange={{fn this.updateDraft "sound"}} />
              <PaperInput @label="道具（顿号分隔）" @value={{this.draft.props}} @onChange={{fn this.updateDraft "props"}} />
              <PaperInput @label="演员（顿号分隔）" @value={{this.draft.cast}} @onChange={{fn this.updateDraft "cast"}} />
              <PaperInput @label="前置提示 cueId（顿号分隔）" @value={{this.draft.dependsOn}} @onChange={{fn this.updateDraft "dependsOn"}} />
              <PaperInput @label="备注" @textarea={{true}} @passThru={{hash rows=3}} @value={{this.draft.notes}} @onChange={{fn this.updateDraft "notes"}} />
              <div class="form-actions">
                {{#if (eq this.editTarget.source "local")}}
                  <PaperButton @warn={{true}} @onClick={{fn this.removeSelectedCue (concat "l:" this.activeSceneId ":" this.editTarget.cueId)}}>删除本场提示</PaperButton>
                {{/if}}
                <span></span>
                <PaperButton @onClick={{this.cancelDraft}}>取消</PaperButton>
                <PaperButton @raised={{true}} @primary={{true}} @onClick={{this.saveCueDraft}}>{{if (eq this.editTarget.source "template") "保存本场覆盖" "保存本场提示"}}</PaperButton>
              </div>
            </div>
          {{else if this.selectedCue}}
            <div class="selected-cue">
              <div class="cue-badges">
                <span class="selected-kind">{{this.selectedCue.kind}}</span>
                <span class="source-badge source-{{this.selectedCue.source}}">{{if (eq this.selectedCue.source "template") "来自模板" "本场自有"}}</span>
                {{#if this.selectedCue.pinned}}<span class="source-badge source-pinned">钉版值</span>{{/if}}
              </div>
              <h3>{{this.selectedCue.title}}</h3>
              {{#if this.selectedCue.overridden.length}}
                <p class="ownership-note">本场已覆盖：{{join "、" this.selectedCue.overridden}}</p>
              {{/if}}
              <dl>
                <dt>负责人</dt><dd>{{if this.selectedCue.owner this.selectedCue.owner "缺失"}}</dd>
                <dt>灯光</dt><dd>{{if this.selectedCue.lighting this.selectedCue.lighting "—"}}</dd>
                <dt>音响</dt><dd>{{if this.selectedCue.sound this.selectedCue.sound "—"}}</dd>
                <dt>道具</dt><dd>{{if this.selectedCue.props.length (join "、" this.selectedCue.props) "—"}}</dd>
                <dt>演员</dt><dd>{{if this.selectedCue.cast.length (join "、" this.selectedCue.cast) "—"}}</dd>
                <dt>备注</dt><dd>{{if this.selectedCue.notes this.selectedCue.notes "—"}}</dd>
              </dl>
              <div class="inspector-actions">
                <PaperButton @onClick={{fn this.editCue this.selectedCue.id}} @raised={{true}} @primary={{true}}>{{if (eq this.selectedCue.source "template") "覆盖本场值" "编辑本场提示"}}</PaperButton>
                <PaperButton @onClick={{fn this.moveSelected -1}}>上移一条</PaperButton>
                <PaperButton @onClick={{fn this.moveSelected 1}}>下移一条</PaperButton>
              </div>
              {{#if (eq this.selectedCue.source "template")}}
                <div class="owner-actions">
                  <label class="skip-toggle">
                    <input type="checkbox" {{on "change" (fn this.toggleSkip this.selectedCue.cueId)}} />
                    本场停用此模板提示
                  </label>
                  <PaperButton @onClick={{fn this.resetCue this.selectedCue.cueId}}>清除全部覆盖，恢复模板值</PaperButton>
                </div>
              {{/if}}
            </div>
          {{else}}
            <p class="empty-copy">选择一条提示查看详细信息。</p>
          {{/if}}
        </section>

        {{#if this.activeScene.detachedOverrides.length}}
          <section class="detached-panel paper-surface">
            <div class="panel-heading"><div><small>MIGRATION SALVAGE</small><h2>待处理覆盖（{{this.activeScene.detachedOverrides.length}}）</h2></div></div>
            <div class="detached-list">
              {{#each this.activeScene.detachedOverrides as |override|}}
                <div class="detached-row">
                  <strong>{{override.cueId}}</strong>
                  <small>覆盖字段：{{join "、" (map-keys override.fields)}}</small>
                  <div class="detached-actions">
                    <PaperButton @onClick={{fn this.restoreOverride override.cueId}}>匹配恢复</PaperButton>
                    <PaperButton @warn={{true}} @onClick={{fn this.discardOverride override.cueId}}>删除</PaperButton>
                  </div>
                </div>
              {{/each}}
            </div>
          </section>
        {{/if}}

        <section class="check-panel paper-surface">
          <div class="panel-heading">
            <div><small>VALIDATION</small><h2>检查提示</h2></div>
            <span class="issue-count">{{this.issues.length}}</span>
          </div>
          <div class="issue-list">
            {{#each this.issues as |issue|}}
              <button type="button" class="issue-item severity-{{issue.severity}}" {{on "click" (fn this.focusIssue issue.sceneId issue.cueId)}}>
                <span class="issue-icon">{{if issue.icon issue.icon "i"}}</span>
                <span><strong>{{issue.title}}</strong><small>{{issue.detail}}</small></span>
              </button>
            {{else}}
              <div class="all-clear"><span>✓</span><p>未发现时间、负责人、撞场、失效引用或模板归属问题。</p></div>
            {{/each}}
          </div>
        </section>

        <section class="version-panel paper-surface">
          <div class="panel-heading"><div><small>LOCKED VERSIONS</small><h2>版本比较</h2></div></div>
          {{#if this.versions.length}}
            <PaperSelect @label="选择锁定版" @options={{this.versions}} @optionLabelPath="name" @selected={{this.compareVersion}} @onChange={{this.selectCompareVersion}} class="version-select" />
            {{#if this.compareVersion}}
              <div class="version-summary">
                <strong>{{this.compareVersion.name}}</strong>
                <small>{{this.compareVersion.state.show.title}} · {{this.versionDiff.length}} 条有效提示</small>
              </div>
              <div class="diff-list">
                {{#each this.versionDiff as |diff|}}
                  <div class="diff-row {{if diff.changed "is-changed"}}">
                    <span>{{diff.label}}</span>
                    <p>{{diff.before}}</p>
                    <p>{{diff.after}}</p>
                  </div>
                {{/each}}
              </div>
            {{/if}}
          {{else}}
            <p class="empty-copy">尚未锁定版本。锁定后快照同时包含模板与场次覆盖，可逐条比较合并视图。</p>
          {{/if}}
        </section>
      </aside>
    </main>
  {{/if}}

  {{#if this.applyPickerOpen}}
    <div class="modal-backdrop" data-test-apply-modal>
      <section class="apply-dialog paper-surface">
        <div class="panel-heading">
          <div><small>APPLY TEMPLATE</small><h2>复制新场次 · 选择模板</h2></div>
          <button type="button" class="close-button" {{on "click" this.closeApplyPicker}}>×</button>
        </div>
        <div class="apply-body">
          <p class="ownership-note">新场次只保存本场覆盖，流程数据留在模板；操作是事务式的，校验或写入失败会整体回滚。</p>
          <div class="apply-template-list">
            {{#each this.applyTemplateRows as |option|}}
              <button type="button" class="apply-option {{if option.selected "is-selected"}}" {{on "click" (fn this.selectApplyTemplate option.id)}}>
                <strong>{{option.name}} · {{option.versionLabel}}</strong>
                <small>{{option.cueCount}} 条提示</small>
                {{#unless option.valid}}
                  <span class="apply-invalid">{{join "；" option.reasons}}</span>
                {{/unless}}
              </button>
            {{/each}}
          </div>
          <div class="apply-fields">
            <PaperInput @label="幕" @value={{this.applyAct}} @onChange={{fn this.updateApplyField "act"}} />
            <PaperInput @label="场号" @value={{this.applyName}} @onChange={{fn this.updateApplyField "name"}} />
            <PaperInput @label="场次标题" @value={{this.applyTitle}} @onChange={{fn this.updateApplyField "title"}} />
            <PaperInput @label="开场时间" @value={{this.applyStartTime}} @onChange={{fn this.updateApplyField "startTime"}} />
          </div>
          {{#if this.applyValidationReasons.length}}
            <div class="apply-reasons">
              <strong>模板校验未通过：</strong>
              <ul>{{#each this.applyValidationReasons as |reason|}}<li>{{reason}}</li>{{/each}}</ul>
            </div>
          {{/if}}
          <label class="skip-toggle fail-toggle">
            <input type="checkbox" checked={{this.applyFailSimulation}} {{on "change" this.toggleFailSimulation}} />
            模拟写入失败（演练回滚与恢复，刷新页面后仍可继续处理）
          </label>
        </div>
        <div class="apply-footer">
          <PaperButton @onClick={{this.closeApplyPicker}}>取消</PaperButton>
          <PaperButton @raised={{true}} @primary={{true}} @disabled={{not this.applyCanSubmit}} @onClick={{this.confirmApplyTemplate}} data-test-apply-confirm>创建场次</PaperButton>
        </div>
      </section>
    </div>
  {{/if}}

  {{#if this.message}}<div class="toast-message">{{this.message}}</div>{{/if}}
</div>
